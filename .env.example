# 钉钉应用凭证
DINGTALK_APP_KEY=你的AppKey
DINGTALK_APP_SECRET=你的AppSecret

# 钉钉知识库配置
DINGTALK_SPACE_ID=你的知识库SpaceId
DINGTALK_ROOT_DENTRY_UUID=知识库根目录的DentryUuid
DINGTALK_ADMIN_UNION_ID=管理员的UnionId

# 文件夹命名规则: month=按月(2026-05)  day=按天(2026-05-27)
FOLDER_FORMAT=month

# OA 调用本服务的鉴权 Key
API_KEY=自定义一个密钥

# 服务端口
PORT=8000
